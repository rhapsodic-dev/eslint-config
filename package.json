{
  "name": "@rhapsodic/eslint-config",
  "type": "module",
  "version": "6.0.0",
  "packageManager": "pnpm@12.8.2+sha512.a5941679663d952c5f0ecc38ba98af98b4dc01b95780354f6894f2f873973cef2f7e2989d7db3ee5393938ae21f62fe06bcdf685d475ddad829a62095d2b8b11",
  "engines": {
    "node": ">=22"
  },
  "description": "Rhapsodic's ESLint config",
  "author": "Svyatoslav Fyodorov <intelrug@gmail.com> (https://github.com/intelrug/)",
  "license": "MIT",
  "homepage": "https://github.com/rhapsodic-dev/eslint-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhapsodic-dev/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/rhapsodic-dev/eslint-config/issues"
  },
  "keywords": [
    "eslint-config"
  ],
  "exports": {
    ".": "./dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "nr gen && tsdown --clean --dts",
    "stub": "tsdown",
    "dev": "npx @eslint/config-inspector --config eslint.config.ts",
    "build:inspector": "pnpm build && npx @eslint/config-inspector build",
    "watch": "tsdown --watch",
    "lint": "eslint",
    "format": "eslint --fix",
    "gen": "tsx scripts/typegen.ts",
    "prepack": "nr build",
    "release": "bumpp",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "eslint": "^10.4.0",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-vuejs-accessibility": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@antfu/install-pkg": "^2.1.0",
    "@clack/prompts": "^1.8.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint-flat-config-utils": "^3.2.0",
    "eslint-merge-processors": "^2.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unicorn": "^76.0.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-processor-vue-blocks": "^2.0.0",
    "globals": "^17.12.0",
    "local-pkg": "^1.2.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "devDependencies": {
    "@rhapsodic/eslint-config": "workspace:*",
    "@antfu/ni": "^30.6.0",
    "@eslint/config-inspector": "^3.5.0",
    "@types/node": "^24.19.0",
    "bumpp": "^12.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "eslint-typegen": "^2.3.1",
    "execa": "^10.0.1",
    "lint-staged": "^17.6.0",
    "pnpm-workspace-yaml": "^1.9.1",
    "simple-git-hooks": "^2.14.0",
    "tinyglobby": "^0.2.17",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix --ignore-pattern=fixtures/** --no-warn-ignored"
  }
}
